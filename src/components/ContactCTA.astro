---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
---

<aside>
	<h2>Ready to work together?</h2>
	<div class="contact-options">
                <CallToAction href="mailto:mail@varsha.de">
                        Send Me a Message
                        <Icon icon="paper-plane-tilt" size="1.2em" />
                </CallToAction>
                <CallToAction href="https://www.linkedin.com/in/varshaviyer/" target="_blank" rel="noopener">
                        LinkedIn
                        <Icon icon="linkedin-logo" size="1.2em" />
                </CallToAction>
	</div>
	<div class="contact-details">
		<p>Tel. +49 15678 248382</p>
		<p>Based in Germany • Available globally via remote interpretation</p>
	</div>
</aside>

<style>
	aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
		border-top: 1px solid var(--gray-800);
		border-bottom: 1px solid var(--gray-800);
		padding: 5rem 1.5rem;
		background-color: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
	}

	h2 {
		font-size: var(--text-xl);
		text-align: center;
		margin-bottom: 1rem;
	}

	.contact-options {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	.contact-details {
		text-align: center;
		color: var(--gray-300);
		font-size: var(--text-sm);
	}

	.contact-details p {
		margin: 0.25rem 0;
	}

	@media (min-width: 50em) {
		aside {
			padding: 7.5rem;
		}

		h2 {
			font-size: var(--text-3xl);
		}

		.contact-options {
			gap: 2rem;
		}
	}
</style>
