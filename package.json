  "bugs": {
    "url": "https://github.com/felixg3/varsha-website/issues"
  },
  "homepage": "https://github.com/felixg3/varsha-website#readme",
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.0",
    "astro": "^5.10.1",
    "cloudflare": "^4.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250628.0",
    "wrangler": "^4.22.0"
  }
