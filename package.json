{
  "name": "varsha-website",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "rm -rf dist .astro public/_astro public/_worker.js && astro build",
    "preview": "astro preview",
    "deploy": "bun run build",
    "deploy:local": "bun run build && bun run deploy:cf",
    "deploy:cf": "node scripts/deploy.js",
    "setup-auth": "node scripts/setup-auth.js",
    "check-access": "node scripts/check-access.js",
    "deploy:simple": "bun run build && npx wrangler deploy",
    "reset-auth": "npx wrangler logout && npx wrangler login",
    "setup-domain": "node scripts/setup-domain-simple.js",
    "deploy:full": "bun run deploy && bun run setup-domain"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixg3/varsha-website.git"
  },
